<Window x:Class="WeatherDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WeatherDashboard.Controls"
        Title="Weather Dashboard" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5"/>
            <Button Content="Get Weather" Command="{Binding FetchWeatherCommand}" Width="100" Margin="5"/>
            <ComboBox ItemsSource="{Binding AvailableApis}" SelectedItem="{Binding SelectedApi}" Width="150" Margin="5"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding WeatherData}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:WeatherCard Weather="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
